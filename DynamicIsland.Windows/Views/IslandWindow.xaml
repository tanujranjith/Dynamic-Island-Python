<Window x:Class="DynamicIsland.Windows.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island" Width="1200" Height="220"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="AppleBlack" Color="#FA000000" />
        <SolidColorBrush x:Key="AppleWhite" Color="#FFF5F5F7" />
        <SolidColorBrush x:Key="AppleSecondary" Color="#FF98989D" />
        <SolidColorBrush x:Key="AppleTrack" Color="#FF36363A" />
        <SolidColorBrush x:Key="AppleGreen" Color="#FF30D158" />

        <Style x:Key="AppleControl" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{Binding ShellControlBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                            <Border x:Name="Hover" CornerRadius="22" Background="{Binding ShellControlHoverBrush}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Activity tiles and timer panels deliberately stay dark in either app theme. -->
        <Style x:Key="AppleControlOnDark" TargetType="Button" BasedOn="{StaticResource AppleControl}">
            <Setter Property="Foreground" Value="{StaticResource AppleWhite}" />
        </Style>

        <Style x:Key="ApplePlayControl" TargetType="Button" BasedOn="{StaticResource AppleControl}">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="Background" Value="{StaticResource AppleWhite}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                            <Border x:Name="Chrome" CornerRadius="25" Background="{TemplateBinding Background}" />
                            <Border x:Name="Hover" CornerRadius="25" Background="#16000000" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppleProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Foreground" Value="{Binding ProgressFillBrush}" />
            <Setter Property="Background" Value="{Binding ProgressTrackBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="3" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatsButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource AppleWhite}" />
            <Setter Property="Background" Value="#FF293444" />
            <Setter Property="BorderBrush" Value="#FF3B4A5F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#FF3A4C67" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.3" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatsPlayButton" TargetType="Button" BasedOn="{StaticResource StatsButton}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Background" Value="#FF315887" />
            <Setter Property="BorderBrush" Value="#FF4D7DB7" />
        </Style>

        <Style x:Key="TimerSurfaceButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFD7D7DC" />
            <Setter Property="Background" Value="#FF19191C" />
            <Setter Property="BorderBrush" Value="#FF343439" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#FF242429" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimerPrimaryButton" TargetType="Button" BasedOn="{StaticResource TimerSurfaceButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF287FF0" />
            <Setter Property="BorderBrush" Value="#FF4D9AFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="QButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="#FFE4E9F2" />
            <Setter Property="Background" Value="#FF1A1D23" />
            <Setter Property="BorderBrush" Value="#FF303843" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF263142" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF426587" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QActionButton" TargetType="Button" BasedOn="{StaticResource QButtonBase}">
            <Setter Property="Foreground" Value="#FFE2E6EF" />
            <Setter Property="Background" Value="#FF1B1F27" />
            <Setter Property="BorderBrush" Value="#FF303A48" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="QResponseActionButton" TargetType="Button" BasedOn="{StaticResource QButtonBase}">
            <Setter Property="Foreground" Value="#FFAEB8C8" />
            <Setter Property="Background" Value="#FF171A20" />
            <Setter Property="BorderBrush" Value="#FF292F39" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="QPrimaryButton" TargetType="Button" BasedOn="{StaticResource QButtonBase}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF287FF0" />
            <Setter Property="BorderBrush" Value="#FF58A4FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="QSendButton" TargetType="Button" BasedOn="{StaticResource QPrimaryButton}">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="QMicButton" TargetType="Button" BasedOn="{StaticResource QButtonBase}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="#FFF5F5F7" />
            <Setter Property="Background" Value="#FF1B1F27" />
        </Style>

        <Style x:Key="QModeButton" TargetType="Button" BasedOn="{StaticResource QButtonBase}">
            <Setter Property="Foreground" Value="#FFAEB8C8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="QAskModeButton" TargetType="Button" BasedOn="{StaticResource QModeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding QIsAsk}" Value="True">
                    <Setter Property="Background" Value="#FF1D4A7A" />
                    <Setter Property="BorderBrush" Value="#FF4D9AFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="#FF74B4FF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QSayModeButton" TargetType="Button" BasedOn="{StaticResource QModeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding QIsSay}" Value="True">
                    <Setter Property="Background" Value="#FF1D4A7A" />
                    <Setter Property="BorderBrush" Value="#FF4D9AFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="#FF74B4FF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TimerTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource AppleWhite}" />
            <Setter Property="Background" Value="#FF151517" />
            <Setter Property="BorderBrush" Value="#FF343439" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="#FF409CFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="TimerComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource AppleWhite}" />
            <Setter Property="Background" Value="#FF151517" />
            <Setter Property="BorderBrush" Value="#FF343439" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        </Style>

        <Storyboard x:Key="QThinkingAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="QThinkingDot1" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.42" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="QThinkingDot2" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.42" BeginTime="0:0:0.12" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="QThinkingDot3" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.42" BeginTime="0:0:0.24" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="QThinkingGlow" Storyboard.TargetProperty="Opacity" From="0.18" To="0.7" Duration="0:0:0.8" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="QShimmer" Storyboard.TargetProperty="Opacity" From="0.15" To="0.7" Duration="0:0:0.8" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="QShimmerTransform" Storyboard.TargetProperty="X" From="-120" To="260" Duration="0:0:1.4" />
        </Storyboard>

        <Storyboard x:Key="NotifIntro">
            <DoubleAnimation Storyboard.TargetName="NotifScale" Storyboard.TargetProperty="ScaleX" From="0.92" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="NotifScale" Storyboard.TargetProperty="ScaleY" From="0.92" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="NotifBanner" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="NotifBlur" Storyboard.TargetProperty="Radius" From="8" To="0" Duration="0:0:0.22" />
            <DoubleAnimation Storyboard.TargetName="NotifGlow" Storyboard.TargetProperty="BlurRadius" From="8" To="14" Duration="0:0:0.2" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="NotifSweepRect" Storyboard.TargetProperty="Opacity" From="0" To="0.6" Duration="0:0:0.12" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="NotifSweep" Storyboard.TargetProperty="X" From="-1" To="1" Duration="0:0:0.34" />
        </Storyboard>
    </Window.Resources>

    <Grid Background="{x:Null}">
        <Border x:Name="GlassShell" Width="230" Height="62" Margin="0,8,0,0"
                HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="{Binding IslandCornerRadius}"
                Background="{Binding IslandSurfaceBrush}" BorderThickness="0"
                RenderTransformOrigin="0.5,0" ClipToBounds="True"
                MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave"
                MouseLeftButtonDown="Pill_MouseLeftButtonDown"
                MouseRightButtonUp="Pill_MouseRightButtonUp">
            <Border.RenderTransform><ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
            <Grid>
                <Border x:Name="BackgroundLayer" Background="{Binding IslandSurfaceBrush}" CornerRadius="{Binding IslandInnerCornerRadius}" IsHitTestVisible="False" />

                <!-- Compact: one calm, glanceable status strip — media, RAM, and time. -->
                <Grid x:Name="CompactContent" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="{Binding CompactAlbumSize}" Height="{Binding CompactAlbumSize}" VerticalAlignment="Center"
                          Visibility="{Binding ShowCompactMediaContent, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="{Binding CompactIconCorner}" Background="{Binding IslandCardBrush}">
                            <TextBlock Text="{Binding CompactGlyph}" FontFamily="Segoe Fluent Icons" FontSize="{Binding CompactGlyphFontSize}"
                                       Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="{Binding CompactIconCorner}" ClipToBounds="True"
                                Visibility="{Binding ShowCompactArt, Converter={StaticResource BoolToVisibility}}">
                            <Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" /></Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="11,0,13,0" VerticalAlignment="Center"
                                Visibility="{Binding ShowCompactMediaContent, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding MediaTitle}" FontFamily="{Binding UiFontFamily}" FontSize="{Binding MediaTitleFontSize}" FontWeight="SemiBold"
                                   Foreground="{Binding PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MediaArtist}" Margin="0,2,0,0" FontFamily="{Binding UiFontFamily}" FontSize="{Binding MediaArtistFontSize}"
                                   Foreground="{Binding SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Grid Grid.Column="0" Width="{Binding CompactAlbumSize}" Height="{Binding CompactAlbumSize}" VerticalAlignment="Center"
                          Visibility="{Binding ShowCompactQContent, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="{Binding CompactIconCorner}" Background="#FF101B2B" BorderBrush="#FF245DA6" BorderThickness="1">
                            <TextBlock Text="Q" FontFamily="Segoe UI Variable Display" FontSize="20" FontWeight="SemiBold" Foreground="#FF5AA7FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="11,0,13,0" VerticalAlignment="Center"
                                Visibility="{Binding ShowCompactQContent, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding QCompactText}" FontFamily="{Binding UiFontFamily}" FontSize="{Binding CompactPrimaryFontSize}" FontWeight="SemiBold"
                                   Foreground="{Binding PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding QStatusText}" Margin="0,2,0,0" FontFamily="{Binding UiFontFamily}" FontSize="{Binding CompactSecondaryFontSize}"
                                   Foreground="{Binding SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="1" Height="30" Margin="0,0,12,0" Background="{Binding IslandDividerBrush}"
                                Visibility="{Binding ShowCompactRam, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Margin="0,0,13,0" Visibility="{Binding ShowCompactRam, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="RAM" FontFamily="{Binding UiFontFamily}" FontSize="8" Foreground="{Binding SecondaryTextBrush}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding RamText}" Margin="0,1,0,0" FontFamily="{Binding UiFontFamily}" FontSize="{Binding CompactSecondaryFontSize}" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ClockTimeText}" FontFamily="{Binding UiFontFamily}" FontSize="{Binding CompactClockFontSize}" FontWeight="SemiBold"
                                       Visibility="{Binding ShowClock, Converter={StaticResource BoolToVisibility}}"
                                       Foreground="{Binding PrimaryTextBrush}" HorizontalAlignment="Right" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Right"
                                        Visibility="{Binding ShowBattery, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding BatteryGlyph}" FontFamily="Segoe Fluent Icons" FontSize="10"
                                           Foreground="{Binding SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding BatteryText}" Margin="4,0,0,0" FontFamily="{Binding UiFontFamily}" FontSize="9.5"
                                           Foreground="{Binding SecondaryTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Stats-heavy compact mode: keep the glanceable lane, but expose the key status values. -->
                <Grid x:Name="StatsCompactContent" Margin="14,0" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Visibility="{Binding ShowMedia, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding CompactPrimaryText}" FontFamily="{Binding UiFontFamily}" FontSize="{Binding CompactPrimaryFontSize}"
                                   FontWeight="SemiBold" Foreground="{Binding PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CompactSecondaryText}" Margin="0,2,0,0" FontFamily="{Binding UiFontFamily}" FontSize="{Binding CompactSecondaryFontSize}"
                                   Foreground="{Binding SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="1" Height="30" Margin="10,0" Background="{Binding IslandDividerBrush}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ClockTimeText}" FontFamily="{Binding UiFontFamily}" FontSize="{Binding CompactClockFontSize}"
                                   FontWeight="SemiBold" Foreground="{Binding PrimaryTextBrush}" HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding ShowBattery, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding BatteryGlyph}" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{Binding SecondaryTextBrush}" />
                            <TextBlock Text="{Binding BatteryText}" Margin="4,1,0,0" FontFamily="{Binding UiFontFamily}" FontSize="9.5" Foreground="{Binding SecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Expanded: one focused now-playing card. -->
                <Grid x:Name="ExpandedContent" Margin="28,22" Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="50" />
                        <!-- The active deck sizes to its content: Apple cards stay compact while
                             the Stats dashboard gets enough height for all three status tiles. -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.RowSpan="3" Width="{Binding ExpandedAlbumSize}" Height="{Binding ExpandedAlbumSize}" Margin="0,0,16,0" VerticalAlignment="Top" Cursor="Hand" MouseLeftButtonUp="AlbumArt_Click">
                        <Border CornerRadius="{Binding ExpandedIconCorner}" Background="{Binding IslandCardBrush}">
                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="34"
                                       Foreground="{Binding SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="{Binding ExpandedIconCorner}" ClipToBounds="True"
                                Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}">
                            <Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" /></Border.Background>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding MediaTitle}" MaxWidth="330" TextTrimming="CharacterEllipsis"
                                   FontFamily="{Binding UiFontFamily}" FontSize="{Binding ExpandedMediaTitleFontSize}" FontWeight="SemiBold"
                                   Foreground="{Binding PrimaryTextBrush}" />
                        <TextBlock Grid.Row="1" Text="{Binding MediaArtist}" Margin="0,3,0,0" MaxWidth="340"
                                   TextTrimming="CharacterEllipsis" FontFamily="{Binding UiFontFamily}" FontSize="{Binding ExpandedMediaArtistFontSize}"
                                   Foreground="{Binding SecondaryTextBrush}" />
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Q" Click="QButton_Click" Style="{StaticResource AppleControl}" Width="34" Height="34" FontSize="13" FontFamily="Segoe UI Variable Text"
                                Foreground="#FF409CFF" ToolTip="Ask Q" AutomationProperties.Name="Open Q" />
                        <Button Content="&#xE916;" Click="TimerButton_Click" Style="{StaticResource AppleControl}"
                                Width="34" Height="34" FontSize="14" ToolTip="Timer"
                                AutomationProperties.Name="Open timer" />
                        <Button Content="&#xE713;" Click="SettingsButton_Click" Style="{StaticResource AppleControl}"
                                Width="34" Height="34" FontSize="14" ToolTip="Settings"
                                AutomationProperties.Name="Open settings" />
                        <Button Content="{Binding VolumeGlyph}" Command="{Binding ToggleMuteCommand}" Style="{StaticResource AppleControl}"
                                Visibility="{Binding ShowVolume, Converter={StaticResource BoolToVisibility}}"
                                Width="34" Height="34" FontSize="14" ToolTip="Mute" />
                        <Button x:Name="OutputDeviceButton" Content="&#xE711;" Style="{StaticResource AppleControl}" Width="34" Height="34" FontSize="14"
                                Visibility="{Binding ShowVolume, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Choose audio output" MouseLeftButtonUp="OutputDevice_Click" />
                        <Button x:Name="MenuButton" Content="&#xE712;" Style="{StaticResource AppleControl}" Width="34" Height="34" FontSize="14"
                                ToolTip="More" Click="MenuButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom" PlacementTarget="{Binding ElementName=MenuButton}" HorizontalOffset="-126" VerticalOffset="6">
                                    <MenuItem Header="Settings" Click="SettingsButton_Click" />
                                    <MenuItem Header="Ask Q" Click="QButton_Click" />
                                    <MenuItem Header="Timer" Click="TimerButton_Click" />
                                    <Separator />
                                    <MenuItem Header="Recenter island" Click="RecenterMenu_Click" />
                                    <MenuItem Header="Collapse" Click="CollapseMenu_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
                          Visibility="{Binding ShowMediaTimes, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding MediaElapsedText}" Width="34" FontFamily="Segoe UI Variable Text" FontSize="10"
                                   Foreground="{Binding SecondaryTextBrush}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Padding="0,8" Cursor="Hand"
                                MouseLeftButtonDown="ProgressBar_SeekStart"
                                MouseMove="ProgressBar_SeekMove"
                                MouseLeftButtonUp="ProgressBar_SeekEnd"
                                LostMouseCapture="ProgressBar_SeekCancel">
                            <ProgressBar Value="{Binding MediaProgress, Mode=OneWay}" Style="{StaticResource AppleProgress}" IsHitTestVisible="False" />
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding MediaTrailingTimeText}" Width="38" TextAlignment="Right"
                                   FontFamily="Segoe UI Variable Text" FontSize="10" Foreground="{Binding SecondaryTextBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <Button Content="&#xE892;" Command="{Binding PreviousCommand}" Style="{StaticResource AppleControl}" AutomationProperties.Name="Previous track" />
                        <Button Content="−10" Command="{Binding SeekBackCommand}" Style="{StaticResource AppleControl}" Margin="8,0,0,0"
                                FontFamily="Segoe UI Variable Text" FontSize="11" FontWeight="SemiBold" ToolTip="Back 10 seconds" AutomationProperties.Name="Back 10 seconds" />
                        <Button Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}" Style="{StaticResource ApplePlayControl}" Margin="14,0" AutomationProperties.Name="Play or pause" />
                        <Button Content="30+" Command="{Binding SeekForwardCommand}" Style="{StaticResource AppleControl}" Margin="0,0,8,0"
                                FontFamily="Segoe UI Variable Text" FontSize="11" FontWeight="SemiBold" ToolTip="Forward 30 seconds" AutomationProperties.Name="Forward 30 seconds" />
                        <Button Content="&#xE893;" Command="{Binding NextCommand}" Style="{StaticResource AppleControl}" AutomationProperties.Name="Next track" />
                    </StackPanel>

                    <!-- A calm live-activity deck: each subject gets its own small, coherent Apple-like zone. -->
                    <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" MinHeight="78">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="142" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="126" />
                            </Grid.ColumnDefinitions>

                            <Border CornerRadius="16" Background="#FF151517" Padding="12,9"
                                    Visibility="{Binding ShowVolume, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <TextBlock Text="VOLUME" FontFamily="Segoe UI Variable Text" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AppleSecondary}" />
                                    <Grid Grid.Row="1" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Button Content="{Binding VolumeGlyph}" Command="{Binding ToggleMuteCommand}" Style="{StaticResource AppleControlOnDark}"
                                                Width="24" Height="24" Margin="0,0,5,0" FontSize="11" ToolTip="Mute" />
                                        <TextBlock Grid.Column="1" Text="{Binding VolumeText}" FontFamily="Segoe UI Variable Text" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AppleWhite}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="&#xE738;" Command="{Binding AdjustVolumeCommand}" CommandParameter="-2" Style="{StaticResource AppleControlOnDark}" Width="22" Height="22" Margin="0" FontSize="9" ToolTip="Volume down" />
                                            <Button Content="&#xE710;" Command="{Binding AdjustVolumeCommand}" CommandParameter="2" Style="{StaticResource AppleControlOnDark}" Width="22" Height="22" Margin="2,0,0,0" FontSize="9" ToolTip="Volume up" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" CornerRadius="16" Background="#FF151517" Padding="12,9"
                                    Visibility="{Binding ShowSystemMonitor, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="SYSTEM" FontFamily="Segoe UI Variable Text" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AppleSecondary}" />
                                    <Grid Margin="0,5,0,0" Height="32">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="MEMORY" FontFamily="Segoe UI Variable Text" FontSize="9" Foreground="{StaticResource AppleSecondary}" />
                                                    <TextBlock Text="{Binding RamText}" FontFamily="Segoe UI Variable Text" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" />
                                                </StackPanel>
                                                <Grid x:Name="RamUsageTrack" Grid.Column="1" Height="22" VerticalAlignment="Bottom" ClipToBounds="True">
                                                    <Border Height="4" CornerRadius="2" Background="#FF303035" VerticalAlignment="Bottom" />
                                                    <Border Height="4" CornerRadius="2" Background="#FFF5F5F7" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource PercentageWidth}">
                                                                <Binding Path="RamPercentValue" />
                                                                <Binding Path="ActualWidth" ElementName="RamUsageTrack" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="NETWORK" FontFamily="Segoe UI Variable Text" FontSize="9" Foreground="{StaticResource AppleSecondary}" />
                                                    <TextBlock Text="{Binding NetText}" TextTrimming="CharacterEllipsis" FontFamily="Segoe UI Variable Text" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" />
                                                </StackPanel>
                                                <Grid Grid.Column="1" Height="22" VerticalAlignment="Bottom" ClipToBounds="True">
                                                    <Polyline Points="{Binding NetSparkline}" Stroke="#FFF5F5F7" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" CornerRadius="16" Background="#FF151517" Padding="12,9"
                                    Visibility="{Binding ShowClock, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding ClockText}" FontFamily="Segoe UI Variable Text" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" VerticalAlignment="Center" />
                                    <Grid Grid.Row="1">
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsCharging, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="&#xE83E;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{StaticResource AppleGreen}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ChargingText}" Margin="4,0,7,0" FontFamily="Segoe UI Variable Text" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource AppleGreen}" />
                                            <TextBlock Text="{Binding DateText}" FontFamily="Segoe UI Variable Text" FontSize="9.5" Foreground="{StaticResource AppleSecondary}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding ShowDate, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowBatteryLevel, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding BatteryGlyph}" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{StaticResource AppleSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding BatteryText}" Margin="4,0,7,0" FontFamily="Segoe UI Variable Text" FontSize="9.5" Foreground="{StaticResource AppleSecondary}" />
                                            <TextBlock Text="{Binding DateText}" FontFamily="Segoe UI Variable Text" FontSize="9.5" Foreground="{StaticResource AppleSecondary}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding ShowDate, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                    </Grid>

                    </Grid>

                    <!-- Stats has a complete, opaque dashboard instead of sitting on top of the
                         Apple media deck. That prevents duplicate artwork/title rows and lets the
                         three live tiles use the full available height. -->
                    <Border x:Name="StatsOverlay" Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Grid.ColumnSpan="3" Padding="18,14"
                            CornerRadius="22" Background="#FF101722" Opacity="0" IsHitTestVisible="False"
                            Visibility="Collapsed" Panel.ZIndex="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="124" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="164" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="LIVE STATS" FontFamily="Segoe UI Variable Text" FontSize="9" FontWeight="SemiBold" Foreground="#FF64D2FF" />
                                <TextBlock Text="  •  NOW PLAYING" FontFamily="Segoe UI Variable Text" FontSize="9" Foreground="#FF8A98AA" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="&#xE916;" Click="TimerButton_Click" Style="{StaticResource AppleControlOnDark}" Width="30" Height="30" FontSize="13" ToolTip="Timer" />
                                <Button Content="&#xE713;" Click="SettingsButton_Click" Style="{StaticResource AppleControlOnDark}" Width="30" Height="30" FontSize="13" ToolTip="Settings" />
                                <Button Content="{Binding VolumeGlyph}" Command="{Binding ToggleMuteCommand}" Style="{StaticResource AppleControlOnDark}" Width="30" Height="30" FontSize="13" ToolTip="Mute" />
                            </StackPanel>

                            <Border Grid.Row="1" Width="104" Height="104" CornerRadius="18" Background="#FF202A39" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="#FF9FB2C9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border CornerRadius="18" ClipToBounds="True" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}">
                                        <Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" /></Border.Background>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MediaTitle}" FontFamily="Segoe UI Variable Text" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding MediaArtist}" Margin="0,2,0,8" FontFamily="Segoe UI Variable Text" FontSize="12" Foreground="{StaticResource AppleSecondary}" TextTrimming="CharacterEllipsis" />
                                <Grid Height="5" Margin="0,0,0,10">
                                    <ProgressBar Value="{Binding MediaProgress, Mode=OneWay}" Style="{StaticResource AppleProgress}"
                                                 Foreground="{StaticResource AppleWhite}" Background="#FF303035" />
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="&#xE892;" Command="{Binding PreviousCommand}" Style="{StaticResource StatsButton}" ToolTip="Previous track" />
                                    <Button Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}" Style="{StaticResource StatsPlayButton}" ToolTip="Play or pause" />
                                    <Button Content="&#xE893;" Command="{Binding NextCommand}" Style="{StaticResource StatsButton}" ToolTip="Next track" />
                                    <TextBlock Text="{Binding MediaElapsedText}" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Variable Text" FontSize="10" Foreground="{StaticResource AppleSecondary}" />
                                    <TextBlock Text="{Binding MediaTrailingTimeText}" Margin="7,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Variable Text" FontSize="10" Foreground="{StaticResource AppleSecondary}" />
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Row="1" Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border CornerRadius="13" Background="#FF1A2533" Padding="11,7" Margin="0,0,0,5">
                                    <Grid><TextBlock Text="MEMORY" FontFamily="Segoe UI Variable Text" FontSize="8" Foreground="#FF8A98AA" /><TextBlock Text="{Binding RamText}" Margin="0,13,0,0" FontFamily="Segoe UI Variable Text" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" /></Grid>
                                </Border>
                                <Border Grid.Row="1" CornerRadius="13" Background="#FF1A2533" Padding="11,7" Margin="0,0,0,5">
                                    <Grid><TextBlock Text="NETWORK" FontFamily="Segoe UI Variable Text" FontSize="8" Foreground="#FF8A98AA" /><TextBlock Text="{Binding NetText}" Margin="0,13,0,0" FontFamily="Segoe UI Variable Text" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" TextTrimming="CharacterEllipsis" /></Grid>
                                </Border>
                                <Border Grid.Row="2" CornerRadius="13" Background="#FF1A2533" Padding="11,7">
                                    <Grid><TextBlock Text="POWER" FontFamily="Segoe UI Variable Text" FontSize="8" Foreground="#FF8A98AA" /><TextBlock Text="{Binding BatteryText}" Margin="0,13,0,0" FontFamily="Segoe UI Variable Text" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" /></Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Active timer live activity: it shares the expanded island and appears directly
                         beneath the existing volume/system/time deck in either visual style. -->
                    <Border x:Name="LiveTimerStrip" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                            Height="76" Margin="0,10,0,0" Padding="14,10" CornerRadius="17"
                            Background="#FF151517" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>

                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE916;" FontFamily="Segoe Fluent Icons" FontSize="26"
                                           Foreground="#FF409CFF" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="TIMER" FontFamily="Segoe UI Variable Text" FontSize="9"
                                               FontWeight="SemiBold" Foreground="#FF409CFF" />
                                    <TextBlock Text="{Binding LiveTimerLabel}" Margin="0,3,0,0"
                                               FontFamily="Segoe UI Variable Text" FontSize="11"
                                               Foreground="{StaticResource AppleSecondary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Column="1" Margin="16,0,18,0" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding TimerRemaining}" FontFamily="Segoe UI Variable Display"
                                           FontSize="29" FontWeight="Light" Foreground="{StaticResource AppleWhite}"
                                           HorizontalAlignment="Center" />
                                <ProgressBar Grid.Row="1" Value="{Binding TimerProgress, Mode=OneWay}"
                                             Height="4" Margin="0,5,0,0" Foreground="#FF409CFF"
                                             Background="#FF303035" Style="{StaticResource AppleProgress}" />
                            </Grid>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="{Binding LiveTimerPrimaryGlyph}" Command="{Binding TimerPrimaryCommand}"
                                        Style="{StaticResource ApplePlayControl}" Width="46" Height="46" Margin="0,0,8,0"
                                        FontSize="17" ToolTip="{Binding LiveTimerPrimaryTooltip}"
                                        AutomationProperties.Name="{Binding LiveTimerPrimaryTooltip}" />
                                <Button Content="&#xE711;" Command="{Binding CancelTimerCommand}"
                                        Style="{StaticResource AppleControlOnDark}" Width="38" Height="38" Margin="0"
                                        FontSize="14" ToolTip="Cancel timer" AutomationProperties.Name="Cancel timer" />
                            </StackPanel>
                        </Grid>
                    </Border>

                <!-- Q overlay: selected Streaming Strip direction. One unified Island shell, fixed chat viewport, pinned composer. -->
                <Grid x:Name="QContent" Grid.Row="0" Grid.Column="0" Grid.RowSpan="5" Grid.ColumnSpan="3"
                      Panel.ZIndex="90" Margin="0" Background="Transparent" ClipToBounds="False" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                    <Border x:Name="QShell" Grid.RowSpan="5" CornerRadius="{Binding IslandCornerRadius}" Background="#FF000000" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="92" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="28,18,28,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="58" Height="58" CornerRadius="18" Background="#FF1674EA" BorderBrush="#FF4B9CFF" BorderThickness="1">
                            <TextBlock Text="Q" FontFamily="Segoe UI Variable Display" FontSize="30" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="Q · VISUAL ASSISTANT" FontFamily="Segoe UI Variable Display" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding QSourceText}" FontFamily="Segoe UI Variable Text" FontSize="11" Foreground="#FFB2B7C2" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="  ·  " FontFamily="Segoe UI Variable Text" FontSize="11" Foreground="#FF686A72" />
                                <TextBlock Text="{Binding QStatusText}" FontFamily="Segoe UI Variable Text" FontSize="11" Foreground="#FF74B4FF" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="&#xE916;" Click="TimerButton_Click" Style="{StaticResource AppleControl}" Width="34" Height="34" FontSize="14" ToolTip="Timer" />
                            <Button Content="&#xE713;" Click="SettingsButton_Click" Style="{StaticResource AppleControl}" Width="34" Height="34" FontSize="14" ToolTip="Settings" />
                            <Button Content="{Binding VolumeGlyph}" Command="{Binding ToggleMuteCommand}" Style="{StaticResource AppleControl}" Width="34" Height="34" FontSize="14" ToolTip="Mute" />
                            <Button Content="&#xE711;" Style="{StaticResource AppleControl}" Width="34" Height="34" FontSize="14" ToolTip="Choose audio output" MouseLeftButtonUp="OutputDevice_Click" />
                            <Button x:Name="QMenuButton" Content="&#xE712;" Click="MenuButton_Click" Style="{StaticResource AppleControl}" Width="34" Height="34" FontSize="14" ToolTip="More">
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Bottom" PlacementTarget="{Binding ElementName=QMenuButton}" HorizontalOffset="-126" VerticalOffset="6">
                                        <MenuItem Header="Settings" Click="SettingsButton_Click" />
                                        <MenuItem Header="Timer" Click="TimerButton_Click" />
                                        <Separator />
                                        <MenuItem Header="Recenter island" Click="RecenterMenu_Click" />
                                        <MenuItem Header="Close Q" Click="QClose_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="28,16,28,4">
                        <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="18" Background="#FF242831" VerticalAlignment="Center">
                                <TextBlock Text="You" FontFamily="Segoe UI Variable Text" FontSize="9" Foreground="#FFD9DEE7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding QPromptDisplay}" Margin="14,0,12,0" FontFamily="Segoe UI Variable Text" FontSize="15" Foreground="{StaticResource AppleWhite}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="&#xE787;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#FF727A86" VerticalAlignment="Center" />
                        </Grid>
                        <Border Grid.Row="1" Background="#FF292C33" />
                        <Border Grid.Row="2" Margin="0,10,0,0" Padding="12,8" Background="#FF11151C" BorderBrush="#FF222B38" BorderThickness="1" CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid Width="48" Height="58" VerticalAlignment="Top">
                                <Border x:Name="QThinkingGlow" Width="56" Height="56" CornerRadius="28" Background="#334D9AFF" Opacity="0.18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Width="42" Height="42" CornerRadius="21" Background="#FF1674EA" BorderBrush="#FF4D9AFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Q" FontFamily="Segoe UI Variable Display" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <Grid Grid.Column="1" Margin="14,0,18,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="180" /></Grid.RowDefinitions>
                                <Border x:Name="QThinkingPanel" Background="#FF172235" BorderBrush="#FF2C5D95" BorderThickness="1" CornerRadius="11" Padding="10,5"
                                        Visibility="{Binding QShowInlineThinking, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="QThinkingDot1" Width="8" Height="8" Margin="0,0,6,0" Fill="#FF63ACFF" Opacity="0.25" />
                                            <Ellipse x:Name="QThinkingDot2" Width="8" Height="8" Margin="0,0,6,0" Fill="#FF63ACFF" Opacity="0.25" />
                                            <Ellipse x:Name="QThinkingDot3" Width="8" Height="8" Margin="0,0,10,0" Fill="#FF63ACFF" Opacity="0.25" />
                                            <TextBlock Text="{Binding QInlineStatusText}" FontFamily="Segoe UI Variable Text" FontSize="13" FontWeight="SemiBold" Foreground="#FF9BCBFF" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border x:Name="QShimmer" Height="2" Width="104" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#FF63ACFF" Opacity="0.15">
                                            <Border.RenderTransform><TranslateTransform x:Name="QShimmerTransform" X="-120" /></Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </Border>
                                <ScrollViewer Grid.Row="1" Margin="0,6,0,0" Height="180" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock Text="{Binding QResponseDisplay}" FontFamily="Segoe UI Variable Text" FontSize="15" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource AppleWhite}" TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Grid>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="Copy" Click="QCopy_Click" Style="{StaticResource QResponseActionButton}" />
                                <Button Content="Retry" Click="QSend_Click" Style="{StaticResource QResponseActionButton}" Margin="6,0,0,0" />
                                <Button Content="Stop" Click="QStop_Click" Style="{StaticResource QResponseActionButton}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="28,0,28,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border VerticalAlignment="Center" Background="#FF15181E" BorderBrush="#FF292F39" BorderThickness="1" CornerRadius="19" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Ask" Click="QAsk_Click" Style="{StaticResource QAskModeButton}" />
                                <Button Content="Say" Click="QSay_Click" Style="{StaticResource QSayModeButton}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="New question" Click="QNew_Click" Style="{StaticResource QActionButton}" Padding="14,8" ToolTip="Clear this answer and start a new question" />
                            <Button Content="Quit Q" Click="QClose_Click" Style="{StaticResource QResponseActionButton}" Padding="14,8" Margin="8,0,0,0" ToolTip="Close Q and return to the normal Dynamic Island" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3" Margin="28,0,28,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="QPromptBox" Style="{StaticResource TimerTextBox}" Height="48" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Ask Q about the active window" KeyDown="QPromptBox_KeyDown" />
                        <Button Grid.Column="1" Content="&#xE720;" Click="QMic_Click" Style="{StaticResource QMicButton}" Margin="8,0,0,0" ToolTip="Dictate" />
                        <Button Grid.Column="2" Content="Send" Click="QSend_Click" Style="{StaticResource QSendButton}" Margin="8,0,0,0" />
                    </Grid>

                </Grid>
                    </Border>
                </Grid>

                <!-- Stats-heavy expanded mode, based on the earlier Premium layout. -->
                <Grid x:Name="StatsExpandedContent" Margin="14,10" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="154" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="138" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="&#xE892;" Command="{Binding PreviousCommand}" Style="{StaticResource StatsButton}" ToolTip="Previous track" />
                            <Button Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}" Style="{StaticResource StatsPlayButton}" ToolTip="Play or pause" />
                            <Button Content="&#xE893;" Command="{Binding NextCommand}" Style="{StaticResource StatsButton}" ToolTip="Next track" />
                        </StackPanel>
                        <Border Margin="2,10,2,0" Padding="4" CornerRadius="14" Background="#FF1B2635" BorderBrush="#FF33465E" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="&#xE738;" Command="{Binding AdjustVolumeCommand}" CommandParameter="-2" Style="{StaticResource StatsButton}" Width="28" Height="26" FontSize="10" ToolTip="Volume down" />
                                <StackPanel Margin="7,0" VerticalAlignment="Center">
                                    <TextBlock Text="VOLUME" FontFamily="{Binding UiFontFamily}" FontSize="8" Foreground="{StaticResource AppleSecondary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding VolumeText}" FontFamily="{Binding UiFontFamily}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" HorizontalAlignment="Center" />
                                </StackPanel>
                                <Button Content="&#xE710;" Command="{Binding AdjustVolumeCommand}" CommandParameter="2" Style="{StaticResource StatsButton}" Width="28" Height="26" FontSize="10" ToolTip="Volume up" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MediaTitle}" FontFamily="{Binding UiFontFamily}" FontSize="{Binding ExpandedMediaTitleFontSize}"
                                   FontWeight="SemiBold" Foreground="{Binding PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MediaArtist}" Margin="0,3,0,10" FontFamily="{Binding UiFontFamily}" FontSize="{Binding ExpandedMediaArtistFontSize}"
                                   Foreground="{Binding SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        <Grid Height="18" Visibility="{Binding ShowMediaTimes, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar Value="{Binding MediaProgress, Mode=OneWay}" Style="{StaticResource AppleProgress}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Visibility="{Binding ShowMediaTimes, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding MediaElapsedText}" FontFamily="{Binding UiFontFamily}" FontSize="9" Foreground="{Binding SecondaryTextBrush}" />
                            <TextBlock Text="{Binding MediaTrailingTimeText}" Margin="8,0,0,0" FontFamily="{Binding UiFontFamily}" FontSize="9" Foreground="{Binding SecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding ShowSystemMonitor, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="RAM " FontFamily="{Binding UiFontFamily}" FontSize="9" Foreground="{Binding SecondaryTextBrush}" />
                            <TextBlock Text="{Binding RamText}" FontFamily="{Binding UiFontFamily}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" />
                            <TextBlock Text="  NETWORK " Margin="12,0,0,0" FontFamily="{Binding UiFontFamily}" FontSize="9" Foreground="{Binding SecondaryTextBrush}" />
                            <TextBlock Text="{Binding NetText}" FontFamily="{Binding UiFontFamily}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ClockText}" FontFamily="{Binding UiFontFamily}" FontSize="{Binding ClockFontSize}" FontWeight="SemiBold"
                                   Foreground="{Binding PrimaryTextBrush}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding DateText}" Margin="0,2,0,0" FontFamily="{Binding UiFontFamily}" FontSize="{Binding DateFontSize}"
                                   Foreground="{Binding SecondaryTextBrush}" HorizontalAlignment="Right" Visibility="{Binding ShowDate, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right" Visibility="{Binding ShowBattery, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding BatteryGlyph}" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{Binding SecondaryTextBrush}" />
                            <TextBlock Text="{Binding BatteryText}" Margin="4,0,0,0" FontFamily="{Binding UiFontFamily}" FontSize="10" Foreground="{Binding SecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Timer and alarm are part of the island surface, not a detached utility window. -->
                <Grid x:Name="TimerPanelContent" Grid.Row="0" Grid.Column="0" Grid.RowSpan="5" Grid.ColumnSpan="3" Panel.ZIndex="100"
                      Margin="0" Background="#FF000000" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed"
                      MouseLeave="TimerPanel_MouseLeave">
                    <Grid Margin="36,22,36,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="62" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="44" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="310" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE916;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="#FF409CFF" VerticalAlignment="Center" />
                            <TextBlock Text="Timer" Margin="12,0,0,0" FontFamily="Segoe UI Variable Display" FontSize="25" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppleWhite}" VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Grid.Column="1" Height="48" CornerRadius="24" Background="#FF111113" BorderBrush="#FF252529" BorderThickness="1">
                            <Grid Margin="3">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Button x:Name="TimerTabButton" Content="Timer" Click="TimerTab_Click" Style="{StaticResource TimerSurfaceButton}"
                                        Padding="0" Background="#FF222226" BorderBrush="#FF39393E" Foreground="#FF66ADFF" />
                                <Button x:Name="AlarmTabButton" Grid.Column="1" Content="Alarm" Click="AlarmTab_Click" Style="{StaticResource TimerSurfaceButton}"
                                        Padding="0" Background="Transparent" BorderBrush="Transparent" Foreground="#FF9C9CA2" />
                            </Grid>
                        </Border>

                        <Button Grid.Column="2" Content="&#xE711;" Click="CloseTimerPanel_Click" Style="{StaticResource AppleControlOnDark}"
                                Width="44" Height="44" FontSize="18" HorizontalAlignment="Right" ToolTip="Close timer" />
                    </Grid>

                    <Border Grid.Row="1" Background="#FF1D1D20" />

                    <Grid x:Name="TimerTabContent" Grid.Row="2" Margin="0,18,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding TimerRemaining}" FontFamily="Segoe UI Variable Display" FontSize="72" FontWeight="Light"
                                   Foreground="{StaticResource AppleWhite}" HorizontalAlignment="Center" />
                        <ProgressBar Grid.Row="1" Value="{Binding TimerProgress, Mode=OneWay}" Width="760" Height="6" Margin="0,12,0,0"
                                     Foreground="#FF318CFF" Background="#FF303035" BorderThickness="0" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                            <Button Content="5m" Command="{Binding StartPresetCommand}" CommandParameter="5" Style="{StaticResource TimerSurfaceButton}" Width="76" Height="48" FontSize="16" Padding="0" Margin="5,0" />
                            <Button Content="10m" Command="{Binding StartPresetCommand}" CommandParameter="10" Style="{StaticResource TimerSurfaceButton}" Width="76" Height="48" FontSize="16" Padding="0" Margin="5,0" />
                            <Button Content="15m" Command="{Binding StartPresetCommand}" CommandParameter="15" Style="{StaticResource TimerSurfaceButton}" Width="76" Height="48" FontSize="16" Padding="0" Margin="5,0" />
                            <Button Content="25m" Command="{Binding StartPresetCommand}" CommandParameter="25" Style="{StaticResource TimerSurfaceButton}" Width="76" Height="48" FontSize="16" Padding="0" Margin="5,0" />
                            <Button Content="30m" Command="{Binding StartPresetCommand}" CommandParameter="30" Style="{StaticResource TimerSurfaceButton}" Width="76" Height="48" FontSize="16" Padding="0" Margin="5,0" />
                            <Border Width="1" Height="38" Margin="13,0" Background="#FF3A3A3F" />
                            <TextBox Text="{Binding CustomMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TimerTextBox}" Width="124" Height="48" FontSize="16" ToolTip="Minutes" />
                            <Button Content="Start" Command="{Binding StartCustomCommand}" Style="{StaticResource TimerPrimaryButton}" Width="112" Height="48" FontSize="16" Margin="10,0,0,0" Padding="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <Button Content="{Binding TimerPrimaryText}" Command="{Binding TimerPrimaryCommand}" Style="{StaticResource TimerSurfaceButton}"
                                    Foreground="#FF66ADFF" Background="Transparent" BorderBrush="Transparent" Padding="16,6" FontSize="16"
                                    Visibility="{Binding IsTimerControllable, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Reset" Command="{Binding ResetTimerCommand}" Style="{StaticResource TimerSurfaceButton}"
                                    Foreground="#FF66ADFF" Background="Transparent" BorderBrush="Transparent" Padding="16,6" FontSize="16" Margin="5,0" />
                            <Border Width="1" Height="24" Margin="12,0" Background="#FF444449" />
                            <Button Content="Cancel" Command="{Binding CancelTimerCommand}" Style="{StaticResource TimerSurfaceButton}"
                                    Background="Transparent" BorderBrush="Transparent" Padding="16,6" FontSize="16" Margin="5,0" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="AlarmTabContent" Grid.Row="2" Margin="64,34,64,12" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBox Text="{Binding AlarmHour, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TimerTextBox}" Width="82" Height="48" FontSize="18" TextAlignment="Center" ToolTip="Hour" />
                            <TextBlock Text=":" Margin="9,0" FontFamily="Segoe UI Variable Display" FontSize="34" Foreground="{StaticResource AppleWhite}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding AlarmMinute, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TimerTextBox}" Width="82" Height="48" FontSize="18" TextAlignment="Center" ToolTip="Minute" />
                            <ComboBox SelectedValue="{Binding AmPm}" SelectedValuePath="Content" Style="{StaticResource TimerComboBox}" Width="94" Height="48" Margin="11,0,0,0">
                                <ComboBoxItem Content="AM" /><ComboBoxItem Content="PM" />
                            </ComboBox>
                            <TextBox Text="{Binding AlarmLabel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TimerTextBox}" Width="240" Height="48" FontSize="16" Margin="14,0,0,0" ToolTip="Optional label" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                            <TextBlock Text="Repeat" FontFamily="Segoe UI Variable Text" FontSize="15" Foreground="{StaticResource AppleSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox ItemsSource="{Binding RepeatOptions}" SelectedItem="{Binding AlarmRepeat}" Style="{StaticResource TimerComboBox}" Width="190" Height="42" FontSize="15" />
                            <CheckBox Content="24-hour" IsChecked="{Binding Use24Hour}" Foreground="#FFC7C7CC" FontFamily="Segoe UI Variable Text" FontSize="15" VerticalAlignment="Center" Margin="24,0,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,34,0,0">
                            <Button Content="Set Alarm" Command="{Binding SetAlarmCommand}" Style="{StaticResource TimerPrimaryButton}" Width="130" Height="46" FontSize="15" Padding="0" />
                            <Button Content="Delete" Command="{Binding DeleteAlarmCommand}" Style="{StaticResource TimerSurfaceButton}" Height="46" FontSize="15" Margin="10,0,0,0" />
                            <Button Content="Dismiss" Command="{Binding DismissAlarmCommand}" Style="{StaticResource TimerSurfaceButton}" Height="46" FontSize="15" Margin="10,0,0,0" />
                            <Button Content="Snooze 5m" Command="{Binding Snooze5Command}" Style="{StaticResource TimerSurfaceButton}" Height="46" FontSize="15" Margin="10,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Border Height="1" Background="#FF1D1D20" VerticalAlignment="Top" />
                        <TextBlock x:Name="TimerFooterText" Text="{Binding TimerFooterText}" FontFamily="Segoe UI Variable Text" FontSize="14"
                                   Foreground="#FF77777D" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                    </Grid>
                    </Grid>
                </Grid>

                    <Popup x:Name="OutputDevicePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=OutputDeviceButton}" StaysOpen="False" AllowsTransparency="True">
                        <Border Margin="0,8,0,0" Padding="8" MinWidth="236" CornerRadius="16" Background="#FA1C1C1E" BorderBrush="#18FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="8,5,8,7">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{StaticResource AppleSecondary}" VerticalAlignment="Center" />
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="Audio output" FontFamily="Segoe UI Variable Text" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppleSecondary}" />
                                        <TextBlock Text="{Binding OutputDeviceText}" FontFamily="Segoe UI Variable Text" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" TextTrimming="CharacterEllipsis" MaxWidth="194" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Height="1" Background="#18FFFFFF" Margin="4,0,4,4" />
                                <ItemsControl ItemsSource="{Binding OutputDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding Id}" Click="OutputDeviceItem_Click" Background="Transparent" BorderThickness="0" Padding="10,7"
                                                    HorizontalContentAlignment="Left" Foreground="{StaticResource AppleWhite}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Variable Text" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#FF0A84FF" Margin="12,0,0,0"
                                                               Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <!-- Apple-style compact timer activity. It is deliberately outside GlassShell so it remains
             a separate orb instead of changing the user's compact island width or media layout. -->
        <Grid x:Name="CompactTimerOrb" Width="54" Height="54" Margin="0,8,0,0"
              HorizontalAlignment="Center" VerticalAlignment="Top" Panel.ZIndex="20"
              Visibility="{Binding ShowTimerOrb, Converter={StaticResource BoolToVisibility}}"
              Cursor="Hand" ToolTip="Hover to open timer"
              MouseEnter="TimerOrb_MouseEnter" MouseLeftButtonUp="TimerOrb_Click">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="TimerOrbTranslate" X="150" />
            </Grid.RenderTransform>
            <Border CornerRadius="30" Background="#FD000000" BorderBrush="#18FFFFFF" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="13" ShadowDepth="2" Opacity="0.42" Color="#CC000000" />
                </Border.Effect>
            </Border>
            <Ellipse Width="38" Height="38" Stroke="#FF4A3214" StrokeThickness="3" Opacity="0.72" />
            <Ellipse Width="38" Height="38" Stroke="#FFFF9F0A" StrokeThickness="3"
                     StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Ellipse.StrokeDashArray>
                    <MultiBinding Converter="{StaticResource RingProgress}">
                        <Binding Path="TimerRemainingProgress" />
                        <Binding Path="TimerOrbPerimeterUnits" />
                    </MultiBinding>
                </Ellipse.StrokeDashArray>
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-90" CenterX="19" CenterY="19" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <TextBlock Text="&#xE916;" FontFamily="Segoe Fluent Icons" FontSize="14"
                       Foreground="#FFFF9F0A" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- Notifications retain their real system behaviour, but use the same quiet black material. -->
        <Grid x:Name="NotifBanner" Margin="0,292,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
              Visibility="{Binding ShowBanner, Converter={StaticResource BoolToVisibility}}" Opacity="0">
            <Grid.RenderTransform><ScaleTransform x:Name="NotifScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
            <Border x:Name="NotifCard" MaxWidth="480" Padding="14,10" CornerRadius="18" Background="#FA111113" BorderBrush="#16FFFFFF" BorderThickness="1" ClipToBounds="True">
                <Border.Effect><DropShadowEffect x:Name="NotifGlow" BlurRadius="14" ShadowDepth="3" Opacity="0.42" Color="#000000" /></Border.Effect>
                <Grid>
                    <StackPanel x:Name="NotifContent">
                        <StackPanel.Effect><BlurEffect x:Name="NotifBlur" Radius="0" /></StackPanel.Effect>
                        <TextBlock Text="{Binding BannerApp}" FontFamily="Segoe UI Variable Text" FontSize="10.5" Foreground="{StaticResource AppleSecondary}" />
                        <TextBlock Text="{Binding BannerTitle}" Margin="0,2,0,0" FontFamily="Segoe UI Variable Text" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" />
                        <TextBlock Text="{Binding BannerBody}" Margin="0,2,0,0" MaxWidth="430" TextWrapping="Wrap" FontFamily="Segoe UI Variable Text" FontSize="11.5" Foreground="#FFD1D1D6" />
                    </StackPanel>
                    <Rectangle x:Name="NotifSweepRect" IsHitTestVisible="False" Opacity="0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <LinearGradientBrush.RelativeTransform><TranslateTransform x:Name="NotifSweep" X="-1" /></LinearGradientBrush.RelativeTransform>
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop x:Name="NotifSweepStop" Color="#70FFFFFF" Offset="0.5" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
            </Border>
        </Grid>

        <Popup x:Name="NotificationHistoryPopup" PlacementTarget="{Binding ElementName=GlassShell}" Placement="Bottom" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True">
            <Border Background="#FA111113" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="16" Padding="8" MinWidth="300" MaxWidth="380">
                <ItemsControl ItemsSource="{Binding NotificationHistory}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding}" Click="OpenHistoryItem_Click" Background="Transparent" BorderThickness="0" Padding="8" HorizontalContentAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="{Binding App}" FontFamily="Segoe UI Variable Text" FontSize="10" Foreground="{StaticResource AppleSecondary}" />
                                    <TextBlock Text="{Binding Title}" FontFamily="Segoe UI Variable Text" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>
    </Grid>
</Window>
